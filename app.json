{
  "name": "Atlas WhatsApp Chatbot",
  "description": "Professional WhatsApp Business chatbot with admin panel and AI integration",
  "keywords": ["whatsapp", "chatbot", "nestjs", "vue3", "ai"],
  "repository": "https://github.com/juamcondor/atlas-whatsapp-bot",
  "logo": "https://www.gstatic.com/images/branding/product/1x/gpt_logo_120.png",
  "success_url": "/",
  "env": {
    "NODE_ENV": {
      "description": "Node environment",
      "value": "production",
      "required": false
    },
    "PORT": {
      "description": "Port number",
      "value": "3001",
      "required": false
    },
    "JWT_SECRET": {
      "description": "JWT Secret for authentication (minimum 32 characters)",
      "value": "change-this-secret-in-production-min-32-chars-change-this-secret",
      "required": true
    },
    "JWT_EXPIRES_IN": {
      "description": "JWT token expiration time",
      "value": "7d",
      "required": false
    },
    "WHATSAPP_ACCESS_TOKEN": {
      "description": "Meta WhatsApp Business Access Token",
      "required": true
    },
    "WHATSAPP_PHONE_NUMBER_ID": {
      "description": "Meta WhatsApp Business Phone Number ID",
      "required": true
    },
    "WHATSAPP_VERIFY_TOKEN": {
      "description": "Webhook verification token",
      "value": "atlas-verify-token",
      "required": false
    },
    "WHATSAPP_APP_SECRET": {
      "description": "Meta app secret",
      "required": true
    },
    "OPENAI_API_KEY": {
      "description": "OpenAI API Key (optional, uses MockAI by default)",
      "required": false
    },
    "OPENAI_MODEL": {
      "description": "OpenAI model to use",
      "value": "gpt-4o-mini",
      "required": false
    },
    "LOCAL_MODE": {
      "description": "Use mock AI instead of OpenAI",
      "value": "false",
      "required": false
    },
    "CORS_ORIGIN": {
      "description": "CORS origin",
      "value": "*",
      "required": false
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:standard-0",
      "as": "DATABASE"
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
